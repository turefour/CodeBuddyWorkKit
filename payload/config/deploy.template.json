{
  "$comment": "部署配置模板：字段说明 + 兜底参考。真正的 config/deploy.json 由 deploy.ps1 按当前用户生成。",
  "version": "1.1.2",
  "host": "127.0.0.1",
  "lan": false,
  "ports": {
    "codevault": 47910,
    "pulse": 47821,
    "tuner": 47822,
    "errvault": 47911
  },
  "apps": ["codevault", "pulse", "tuner", "errvault"],
  "paths": {
    "workspace": "%USERPROFILE%\\CodeBuddy",
    "codeRoots": ["%USERPROFILE%\\CodeBuddy", "%USERPROFILE%\\Desktop"],
    "scriptDir": "%USERPROFILE%\\Desktop\\handdelete",
    "vaultRoot": "%USERPROFILE%\\Desktop\\ScriptVault"
  },
  "rules": ["deploy-target.mdc"],
  "runtime": "%LOCALAPPDATA%\\CodeBuddyWorkKit\\runtime\\node.exe"
}
